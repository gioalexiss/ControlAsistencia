# ============================================
# VARIABLES DE ENTORNO - Control de Asistencia
# ============================================

# Base de datos
DB_PASSWORD=tu_password_mysql

# Configuración de correo electrónico
# IMPORTANTE: Usa una contraseña de aplicación de Gmail, NO tu contraseña normal
# Para generar una contraseña de aplicación:
# 1. Ve a https://myaccount.google.com/security
# 2. Activa la verificación en 2 pasos
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una nueva contraseña para "Correo"
# 5. Usa esa contraseña aquí

MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_aplicacion_gmail

# Opcional: Configuración avanzada de correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10000
MAIL_LOG_LEVEL=INFO
