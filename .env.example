# ============================================
# VARIABLES DE ENTORNO - Control de Asistencia
# ============================================

# Base de datos
DB_PASSWORD=tu_password_mysql

# Configuración de correo - SendGrid API HTTP
# IMPORTANTE: Debes crear una cuenta gratuita en SendGrid
# 1. Regístrate en https://signup.sendgrid.com/
# 2. Verifica tu correo de registro
# 3. Ve a Settings > API Keys > Create API Key (Full Access)
# 4. Copia la API Key (SG.xxx...)
# 5. Ve a Settings > Sender Authentication > Single Sender Verification
# 6. Verifica el correo que usarás como remitente
# 7. Configura estas variables:

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=tu_correo_verificado@gmail.com
SENDGRID_FROM_NAME=Sistema Control de Asistencia
